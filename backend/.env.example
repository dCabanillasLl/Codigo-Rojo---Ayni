# Copiar a .env dentro de backend. No compartir ni versionar el archivo .env.
NODE_ENV=development
PORT=3002
FRONTEND_ORIGIN=http://localhost:8444,http://127.0.0.1:8444,http://localhost:8445,http://127.0.0.1:8445
# Generar un secreto aleatorio de al menos 32 caracteres. Nunca usar el del ejemplo.
JWT_SECRET=
COOKIE_SECURE=false
# Solo usar true detrás de un proxy de confianza que termine HTTPS.
TRUST_PROXY=false
# API Perú DNI: backend only. Get the private key from your API Perú account.
APIPERU_API_KEY=
# Stable random secret (at least 32 bytes) used to store only a keyed DNI fingerprint.
DNI_HASH_SECRET=

# Asistente conversacional Gemini (backend only; never use a VITE_GEMINI_API_KEY).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Correo transaccional. Gmail no requiere comprar dominio; usa una contraseña de aplicación.
# EMAIL_PROVIDER=gmail (opción recomendada) o resend.
EMAIL_PROVIDER=gmail
GMAIL_USER=ayni.proyectocodigorojo@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM=AYNI <ayni.proyectocodigorojo@gmail.com>
# Alternativa si el dominio ya está verificado en Resend:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=AYNI <notificaciones@tu-dominio-verificado.com>

# Valores de conexión de Aiven. Copiar a backend/.env y completar allí los valores reales.
DB_HOST=tu-servicio.a.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
# Ruta local al certificado CA descargado de Aiven. Obligatorio para MySQL remoto.
# TLS valida cadena y hostname; no uses rejectUnauthorized=false.
DB_SSL_CA=./certs/ca.pem
DB_TLS=true
# DB_TLS=false solo se permite para MySQL local (localhost/127.0.0.1/::1).
# Proveedor opcional de búsqueda de direcciones compatible con Nominatim.
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# Sugerencias al escribir y dirección desde un punto: proveedor compatible con Photon.
# La instancia pública sirve para uso moderado; configura una propia para mayor tráfico.
# PLACES_API_URL=https://photon.komoot.io/
