# Copiar a .env dentro de backend. No compartir ni versionar el archivo .env.
NODE_ENV=development
PORT=3002
FRONTEND_ORIGIN=http://localhost:8444,http://127.0.0.1:8444,http://localhost:8445,http://127.0.0.1:8445
# Generar un secreto aleatorio de al menos 32 caracteres. Nunca usar el del ejemplo.
JWT_SECRET=
COOKIE_SECURE=false
# Solo usar true detrás de un proxy de confianza que termine HTTPS.
TRUST_PROXY=false
# API Perú DNI: backend only. Get the private key from your API Perú account.
APIPERU_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJlbWFpbCI6ImRjbGwuMDgxMTA1QGdtYWlsLmNvbSIsImp0aSI6IjE0OWEzNzVkNGI5ZTU4MjQifQ.KT8MSyZPR0FaCaGXWeQmfhOAfcj28JcPhm9OQsdDZTQ
# Stable random secret (at least 32 bytes) used to store only a keyed DNI fingerprint.
DNI_HASH_SECRET=uJ76OD+yQQ7GWLqu3MUxJkEjevC+AR9kbeJ5mzYBrmY=

# Valores de conexión de Aiven. Copiar a backend/.env y completar allí los valores reales.
DB_HOST=tu-servicio.a.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
# Ruta local al certificado CA descargado de Aiven. Obligatorio para MySQL remoto.
# TLS valida cadena y hostname; no uses rejectUnauthorized=false.
DB_SSL_CA=./certs/ca.pem
DB_TLS=true
# DB_TLS=false solo se permite para MySQL local (localhost/127.0.0.1/::1).
