# Copiar a .env dentro de backend. No compartir ni versionar el archivo .env.
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:8443,http://127.0.0.1:8443
# Generar un secreto aleatorio de al menos 32 caracteres. Nunca usar el del ejemplo.
JWT_SECRET=
COOKIE_SECURE=false
# Solo usar true detrás de un proxy de confianza que termine HTTPS.
TRUST_PROXY=false

# Valores de conexión de Aiven. Copiar a backend/.env y completar allí los valores reales.
DB_HOST=tu-servicio.a.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
# Ruta local al certificado CA descargado de Aiven. Obligatorio para MySQL remoto.
# TLS valida cadena y hostname; no uses rejectUnauthorized=false.
DB_SSL_CA=./certs/ca.pem
DB_TLS=true
# DB_TLS=false solo se permite para MySQL local (localhost/127.0.0.1/::1).