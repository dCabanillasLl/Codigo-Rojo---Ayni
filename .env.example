# The Vite development server proxies /api to the backend.
VITE_API_URL=/api
# Optional public web address, used in shared notices (also in the Android app).
# VITE_PUBLIC_APP_URL=https://tu-web-de-ayni.example
# Development proxy only; never put database credentials in VITE_* variables.
AYNI_API_TARGET=http://127.0.0.1:3002
# Optional map provider. Set its required attribution when changing the tile URL.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=OpenStreetMap contributors
